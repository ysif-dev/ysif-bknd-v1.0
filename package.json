{
  "name": "youth-spark-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Youth Spark India Foundation - Production API Server & Neon Database Engine",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "postinstall": "prisma generate",
