# ==============================================================================
# Youth Spark India Foundation (YSIF) - Backend API Server Environment Template
# Production Deployment: Vercel Project 2 (Backend API Server)
# IMPORTANT: Never commit actual secret credentials into Git or version control!
# ==============================================================================

# Neon Cloud Serverless PostgreSQL Connection URIs
# Obtain from console.neon.tech
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/neondb?sslmode=require"

# Session Security (HMAC-SHA256 signature secret - must match frontend)
SESSION_SECRET="replace_with_a_secure_random_64_character_hex_string"

# CORS Origin Allowlist: Authorized Frontend Origin
# Development: "http://localhost:3000"
# Production:  "https://your-frontend-project.vercel.app"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Cloudinary Media Infrastructure
CLOUDINARY_CLOUD_NAME="youth-spark-foundation"
CLOUDINARY_API_KEY="replace_with_your_cloudinary_api_key"
CLOUDINARY_API_SECRET="replace_with_your_cloudinary_api_secret"

# Resend Transactional Email & 2FA Admin OTP (Server-Side Only - Never prefix with NEXT_PUBLIC_)
RESEND_API_KEY="replace_with_your_resend_api_key"
RESEND_ADMIN_OTP_TEMPLATE_ID="498949c2-7df7-48f1-9c9e-b448db57a7de"
RESEND_ADMIN_ACTIVATION_TEMPLATE_ID="a9a45ddb-b84b-45a4-a51f-57876c34a0f5"

# Sender Identity:
# Sandbox / Development: "onboarding@resend.dev"
# Production:            "auth@youthsparkindia.org" (requires custom verified domain in Resend)
RESEND_FROM_EMAIL="onboarding@resend.dev"
OTP_FROM_EMAIL="onboarding@resend.dev"
ADMIN_EMAIL_OTP_ENABLED="true"

# Initial Super Administrator Provisioning (Untracked local credentials)
INITIAL_ADMIN_EMAIL="Admin Email"
INITIAL_ADMIN_PASSWORD="replace_with_a_strong_password"
INITIAL_ADMIN_NAME="YSIF Super Administrator"

# Environment Mode
NODE_ENV="development"
